  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dear Danny,\n\nBy the time you read this, I may already be gone. Please
    forgive me for making this decision, my best friend.\n\nThe bullying I went through
    at school hurt me more deeply than I realized. I thought it would all fade with
    time, but even after all these years, whenever I close my eyes, I can still see
    the fists swinging at me and hear that harsh, mocking laughter.\n\nI\u2019ve
    been so tired all these years, and I really don\u2019t think I can hold on any
    longer. Danny, you\u2019re braver than I am. I hope life treats you well.\n\nGoodbye,
    my best friend"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
